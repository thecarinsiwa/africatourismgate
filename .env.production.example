# Copy to .env on the VPS: cp .env.production.example .env
# Then edit secrets and domain URLs before the first deploy.

NODE_ENV=production

# Database (MySQL on the same VPS or managed DB)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=atg
DATABASE_PASSWORD=change-me
DATABASE_NAME=africatourismgate
# API startup bootstrap can stay disabled in production: deploy scripts run `pnpm db:sync`
# after build and before PM2 restart.
DATABASE_AUTO_SCHEMA=false
DATABASE_AUTO_SEED=false
DATABASE_LOGGING=false

# API (NestJS) — port interne 3000 ; nginx expose https://app-africatourismgate.org/api
API_PORT=3000
API_GLOBAL_PREFIX=api

# Public URLs (Next.js build reads these from repo root .env — run `pnpm build` after changes)
NEXT_PUBLIC_API_URL=https://app-africatourismgate.org/api
# Site public uniquement — apps/web (nginx port 3002). Ne pas mettre l’admin ici.
NEXT_PUBLIC_WEB_URL=https://africatourismgate.org
# Back-office uniquement — apps/admin (nginx port 3001). Connexion : …/login
NEXT_PUBLIC_ADMIN_URL=https://app-africatourismgate.org
# GAP — Gorilla Ambassadors Program (nginx port 3004, optionnel)
NEXT_PUBLIC_GAP_URL=https://gap.africatourismgate.org
# Optional fallback donate URL when not set in GAP CMS (/gap/parametres)
NEXT_PUBLIC_GAP_DONATE_URL=

# CORS — origins allowed to call the API (include www variants if used)
CORS_ORIGIN=https://africatourismgate.org,https://www.africatourismgate.org,https://app-africatourismgate.org,https://www.app-africatourismgate.org,https://gap.africatourismgate.org

# Email (LWS — SSL/TLS recommandé)
EMAIL_ENABLED=true
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Africa Tourism Gate <service@africatourismgate.org>"
EMAIL_SUPPORT_FROM="Africa Tourism Gate Support <support@africatourismgate.org>"
EMAIL_SUPPORT_TO=support@africatourismgate.org
SMTP_HOST=mail.africatourismgate.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_SERVICE_USER=service@africatourismgate.org
# SMTP_SERVICE_PASS=   # VPS .env only — mot de passe boîte service@
SMTP_SUPPORT_USER=support@africatourismgate.org
# SMTP_SUPPORT_PASS=   # VPS .env only — mot de passe boîte support@

JWT_ACCESS_SECRET=generate-a-long-random-string
JWT_REFRESH_SECRET=generate-another-long-random-string

# Google OAuth (web booking login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://app-africatourismgate.org/api/auth/google/callback

# PM2 optional POS (heavier — enable only if needed 24/7)
# ATG_ENABLE_POS=1
# PM2 GAP site (enabled automatically when NEXT_PUBLIC_GAP_URL is set, or force with ATG_ENABLE_GAP=1)
ATG_ENABLE_GAP=1
# Optional: same-origin API for GAP builds — nginx proxies /api on gap.africatourismgate.org
# NEXT_PUBLIC_API_URL=https://gap.africatourismgate.org/api
