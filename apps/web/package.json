{
  "name": "@africatourismgate/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "test:components": "vitest run",
    "test:components:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci:build": "node ./scripts/with-e2e-dist.mjs pnpm build",
    "test:e2e:ci:run": "node ./scripts/with-e2e-dist.mjs playwright test",
    "test:e2e:ci": "pnpm run test:e2e:ci:build && pnpm run test:e2e:ci:run",
    "test:e2e:loyalty": "node ./scripts/with-e2e-dist.mjs pnpm build && node ./scripts/with-e2e-dist.mjs playwright test -c playwright.loyalty.config.ts"
  },
  "dependencies": {
    "@africatourismgate/api-client": "workspace:*",
    "@africatourismgate/types": "workspace:*",
    "@africatourismgate/ui": "workspace:*",
    "@africatourismgate/utils": "workspace:*",
    "leaflet": "^1.9.4",
    "next": "14.2.18",
    "next-intl": "^3.26.0",
    "nextjs-toploader": "^3.9.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@africatourismgate/config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.18",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
