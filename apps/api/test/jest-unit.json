{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(booking-detail-pdf|pos-receipt-pdf|accommodation-workbook|accommodation-pdf|oauth-state\\.util|auth\\.service\\.session|site-search\\.constants|site-search-scoring|public-site-search\\.service|treasury-transitions)\\.spec\\.ts$",
  "setupFiles": ["<rootDir>/test/setup-unit-env.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
