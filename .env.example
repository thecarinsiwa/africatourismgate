# Database (MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=africatourismgate
# E2E (apps/api test:e2e): use a separate database, e.g. africatourismgate_test
# On API startup: import database/africatourismgate_database.sql if no application tables exist (set false to disable)
DATABASE_AUTO_SCHEMA=true
# On API startup: import database/seeds/install.seed.sql if the platform organization is missing (set false to disable)
DATABASE_AUTO_SEED=true

# API (NestJS) — apps/api — http://localhost:3000/api
API_PORT=3000
API_GLOBAL_PREFIX=api

# Next.js apps (dev ports; used by pnpm dev scripts)
ADMIN_PORT=3001
WEB_PORT=3002
POS_PORT=3003

# Public API URL for Next.js apps (browser + server)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Site public (apps/web) — production: https://africatourismgate.org
NEXT_PUBLIC_WEB_URL=http://localhost:3002
# Back-office admin (apps/admin) — production: https://app-africatourismgate.org/login
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Admin password reset link base (fallback if email SMTP unavailable in dev)
ADMIN_RESET_PASSWORD_URL=http://localhost:3001/reset-password

# Email (SMTP) — apps/api
# Dev: Mailpit http://localhost:8025 (SMTP :1025) — EMAIL_TRANSPORT=mailpit
# Prod (LWS): mail.africatourismgate.org — port 465 SSL ou 587 TLS
EMAIL_ENABLED=true
EMAIL_TRANSPORT=mailpit
# Logo inline (URL HTTPS publique — pas de pièce jointe dans la boîte de réception)
# EMAIL_LOGO_URL=https://app-africatourismgate.org/api/email-assets/atg-logo.png
# Compte service — e-mails clients (bienvenue, réservation, reset mot de passe)
EMAIL_FROM=Africa Tourism Gate <service@africatourismgate.org>
SMTP_SERVICE_USER=service@africatourismgate.org
# SMTP_SERVICE_PASS=   # .env.local / VPS uniquement — mot de passe boîte service@
# Compte support — alertes internes (nouveau compte, réservation confirmée)
EMAIL_SUPPORT_FROM=Africa Tourism Gate Support <support@africatourismgate.org>
EMAIL_SUPPORT_TO=support@africatourismgate.org
SMTP_SUPPORT_USER=support@africatourismgate.org
# SMTP_SUPPORT_PASS=   # .env.local / VPS uniquement — mot de passe boîte support@
# Serveur SMTP (partagé par les deux comptes)
# SMTP_HOST=mail.africatourismgate.org
# SMTP_HOST=mail93.lwspanel.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Production SSL (recommandé LWS) :
# SMTP_PORT=465
# SMTP_SECURE=true
# Alternative TLS :
# SMTP_PORT=587
# SMTP_SECURE=false
# Rétrocompat (si SMTP_SERVICE_* absent) :
# SMTP_USER=
# SMTP_PASS=

# CORS — required when running all frontends with pnpm dev
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003

# Local integration test scripts (apps/api/scripts/*) — use .env.local, never commit values
# SEED_ADMIN_PASSWORD=          # matches seed admin; see database/seeds/README.md
# RBAC_TEST_SUPPORT_PASSWORD=   # password for RBAC test support user (local only)

# JWT (optional in dev — auto-generated into .env.local on first API start)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (test keys: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Publishable key for POS / web Payment Element (pk_test_…)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# Local webhook forwarding: stripe listen --forward-to localhost:3000/api/stripe/webhook

# Google OAuth (client web login — booking funnel)
# Console Google : URI de redirection autorisée = GOOGLE_CALLBACK_URL (exact match)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev (API_PORT=3000) : http://localhost:3000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
